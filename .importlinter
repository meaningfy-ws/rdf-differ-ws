; =============================================================================
; Import Linter — Architecture Guardrails for RDF Differ
; =============================================================================
; Enforces the cosmic-python layer direction so the architecture cannot erode
; silently. `make check-architecture` (wraps `poetry run lint-imports`) gates it.
;
; Direction:  entrypoints -> services -> adapters -> domain
;   * entrypoints  : API/UI/CLI glue (Connexion, Flask, Click)
;   * services     : use-case orchestration (incl. the Celery tasks)
;   * adapters     : Fuseki/SPARQL/Redis/oxigraph/rdflib/filesystem infrastructure
;   * domain       : pure domain model (imports nothing inward; pydantic allowed)
;
; `rdf_differ.utils` was dissolved into the proper layers (modernization /
; rdf-loading-module DEC-7); the legacy utils contracts are gone.

[importlinter]
root_package = rdf_differ
; required because the store-seam / domain-purity contracts forbid external libs
include_external_packages = True

[importlinter:contract:layers]
name = Cosmic-python layers: entrypoints > services > adapters > domain
type = layers
layers =
    rdf_differ.entrypoints
    rdf_differ.services
    rdf_differ.adapters
    rdf_differ.domain

; DIP at the store seam (DEC-8). Scoped to the new loading service module, which
; MUST reach the triple store only through `GraphStorePort` — never a store/report
; library directly. (Legacy services predate this and are addressed separately.)
[importlinter:contract:loading-services-store-seam]
name = services.loading must not import store/report libraries (DIP)
type = forbidden
source_modules =
    rdf_differ.services.loading
forbidden_modules =
    pyoxigraph
    rdflib
    requests
    SPARQLWrapper
    eds4jinja2

; Domain purity (DEC-8): the domain layer must not depend on I/O frameworks.
[importlinter:contract:domain-purity]
name = domain must not import I/O frameworks
type = forbidden
source_modules =
    rdf_differ.domain
forbidden_modules =
    flask
    connexion
    celery
    click
    requests
    pyoxigraph
    eds4jinja2
    SPARQLWrapper

; The three GraphStorePort implementations must not import each other (DEC-8).
[importlinter:contract:store-adapter-independence]
name = store adapters are independent of each other
type = independence
modules =
    rdf_differ.adapters.loading.remote_store
    rdf_differ.adapters.loading.in_memory_oxigraph_store
    rdf_differ.adapters.loading.in_memory_rdflib_store
