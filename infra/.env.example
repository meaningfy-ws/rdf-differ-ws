# Example environment for the Docker/compose stack.
# Copy to `infra/.env` (and `infra/.env-test` for the test stack) and fill in real values.
# `infra/.env` and `infra/.env-test` are git-ignored — NEVER commit real secrets.
# SECRETS below MUST be set to your own values (passwords, SECRET_KEY_*, flower admin).

RDF_DIFFER_DEBUG=True
RDF_DIFFER_FILENAME=file
RDF_DIFFER_TEMPLATE_LOCATION=/usr/src/template

RDF_DIFFER_UI_PORT=8030
RDF_DIFFER_API_PORT=4030
RDF_DIFFER_API_LOCATION=http://rdf-differ-api
RDF_DIFFER_GUNICORN_API_WORKERS=2
RDF_DIFFER_GUNICORN_UI_WORKERS=1
RDF_DIFFER_GUNICORN_TIMEOUT=1200

RDF_DIFFER_FUSEKI_DATA_FOLDER=fuseki-data
RDF_DIFFER_FUSEKI_PORT=3030
RDF_DIFFER_FUSEKI_LOCATION=http://fuseki
RDF_DIFFER_FUSEKI_USERNAME=admin
RDF_DIFFER_FUSEKI_PASSWORD=CHANGE_ME
RDF_DIFFER_FUSEKI_ADMIN_PASSWORD=CHANGE_ME
RDF_DIFFER_FUSEKI_JVM_ARGS=-Xmx2g

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RDF_DIFFER_SECRET_KEY_UI=CHANGE_ME
RDF_DIFFER_SECRET_KEY_API=CHANGE_ME

RDF_DIFFER_API_LOGS=logs/api.log
RDF_DIFFER_UI_LOGS=logs/ui.log
RDF_DIFFER_CELERY_LOGS=logs/celery.log

RDF_DIFFER_REDIS_PORT=6379
RDF_DIFFER_REDIS_LOCATION=redis://redis

RDF_FLOWER_PORT=5555
RDF_FLOWER_ADMIN_PASSWORD=CHANGE_ME

RDF_DIFFER_TIME_FORMAT=%d-%b-%YT%H:%M:%S
RDF_DIFFER_TIMEZONE=Europe/Paris
SHOW_SWAGGER_UI=true

RDF_DIFFER_LOG_LEVEL=debug
