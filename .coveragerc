# coverage.py configuration — renders to .coveragerc at the repo root.
# No-src layout: measure the top-level package directly.
[run]
branch = True
source = rdf_differ
omit = */__init__.py

[report]
# Gate set to the CURRENT measured level (unit suite ≈68%), floored to 65 as a
# non-regression ratchet — NOT the 80% target. Raising to >=80% needs new tests
# and is a deferred follow-up (per the modernization EPIC, slice 6 is structure-only).
fail_under = 65
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    ^\s+\.\.\.$
    def __repr__
    raise NotImplementedError
